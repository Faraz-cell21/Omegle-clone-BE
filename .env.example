# Database Configuration
DB_NAME=omegle_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration (for Channels)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Cloudflare Turnstile (use test keys for local dev)
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Set True to skip verification in development
TURNSTILE_BYPASS=False

# Load/stress testing (local only — never enable in production)
LOAD_TEST_BYPASS_LIMITS=False
